{
  "name": "@local/dsh-opencode-go-usage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness plugin: show OpenCode GO plan usage (5-hour / weekly / monthly quota windows) below the chat composer.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/*.png",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "icon": "./icon.svg"
}
